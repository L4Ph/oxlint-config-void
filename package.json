{
  "name": "oxlint-config-void",
  "version": "0.0.0",
  "private": true,
  "description": "Oxlint rules and agent skills that hold a Void app to the way Void's documentation says to write one.",
  "license": "MIT",
  "files": [
    "dist",
    "norms",
    "skills"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./vite-plus": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./plugin": {
      "types": "./dist/plugin/index.d.mts",
      "default": "./dist/plugin/index.mjs"
    }
  },
  "scripts": {
    "prepare": "vp pack",
    "build": "vp pack",
    "test": "vp test run",
    "check": "vp check"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3",
    "vite-plus": "^1.7.0",
    "void": "1.11.0"
  },
  "peerDependencies": {
    "vite-plus": ">=1.4.0"
  },
  "peerDependenciesMeta": {
    "vite-plus": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.20.0"
}
